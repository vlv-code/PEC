#include <windows.h>

1 24 "setup.manifest"
100 ICON "../gui/res/logo.ico"

#ifdef EMBED_PAYLOAD
101 RCDATA "payload.zip"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,2,0,0
PRODUCTVERSION 2,2,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PEC Team"
            VALUE "FileDescription", "PEC-App Setup & Installer"
            VALUE "FileVersion", "2.2.0.0"
            VALUE "InternalName", "PEC-App-Setup"
            VALUE "LegalCopyright", "Copyright (C) 2026 PEC Team"
            VALUE "OriginalFilename", "PEC-App-Setup.exe"
            VALUE "ProductName", "PEC-App"
            VALUE "ProductVersion", "2.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
