#include <windows.h>

#if defined(__has_include)
#if __has_include("version_gen.h")
#include "version_gen.h"
#endif
#endif

1 24 "setup.manifest"
100 ICON "../gui/res/logo.ico"

#ifdef EMBED_PAYLOAD
101 RCDATA "payload.zip"
#endif

#ifndef APP_VER_MAJOR
#define APP_VER_MAJOR 2
#endif
#ifndef APP_VER_MINOR
#define APP_VER_MINOR 2
#endif
#ifndef APP_VER_PATCH
#define APP_VER_PATCH 0
#endif
#ifndef APP_VER_BUILD
#define APP_VER_BUILD 0
#endif

#ifndef APP_STR_HELPER
#define APP_STR_HELPER(x) #x
#define APP_STR(x) APP_STR_HELPER(x)
#endif

#ifndef APP_VERSION_STR
#define APP_VERSION_STR APP_STR(APP_VER_MAJOR) "." APP_STR(APP_VER_MINOR) "." APP_STR(APP_VER_PATCH) "." APP_STR(APP_VER_BUILD)
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,APP_VER_BUILD
PRODUCTVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,APP_VER_BUILD
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PEC Team"
            VALUE "FileDescription", "PEC-App Setup & Installer"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "PEC-App-Setup"
            VALUE "LegalCopyright", "Copyright (C) 2026 PEC Team"
            VALUE "OriginalFilename", "PEC-App-Setup.exe"
            VALUE "ProductName", "PEC-App"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
