# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Node.js dependencies and logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build artifacts
dist/
dist_test/
build/

# Environment variables and sensitive data
.env
.env.local
.env.*.local
current_creds.json
instances_meta.json
*.tmp


# Runtime state files (generated at runtime - never commit; may contain secrets)
rotation_config.json
rotation_history.json
proxy_config.json
routing_profiles.json
extension_build_config.json
data/

# Certificates and private keys (protect production secrets)
*.pem
*.key
*.crt
*.pfx
extension/key.pem

# Generated extension packages
*.crx

# OS generated files
.DS_Store
Thumbs.db
