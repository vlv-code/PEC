{
  "name": "pec-proxy-extension-corp",
  "version": "1.4.0",
  "description": "PEC - Proxy Extension Corp: Enterprise proxy synchronization server, live extension builder studio, GPO policies & 3x-ui rotator",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "pack:extension": "tsx scripts/pack-extension.ts",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage test/*.test.ts"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
