[Unit]
Description=PEC - Proxy Extension Corp Enterprise Server
Documentation=https://github.com/corp/pec-proxy-extension-corp
After=network.target

[Service]
Type=simple
User=pecuser
Group=pecgroup
WorkingDirectory=/opt/pec-proxy-server
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
EnvironmentFile=/opt/pec-proxy-server/.env
Environment=CREDS_STORE=/opt/pec-proxy-server/data/current_creds.json
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pec-proxy-server

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/pec-proxy-server/data /opt/pec-proxy-server/extension /opt/pec-proxy-server/dist/updates

[Install]
WantedBy=multi-user.target
