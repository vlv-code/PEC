# PEC - Proxy Extension Corp: environment configuration
# Copy to .env, fill real values, chmod 600.

# --- Core server ---
PORT=3000
HOST=0.0.0.0

# Fleet token: required by the Chrome extension fleet (X-Ext-Token). This is
# the LOW-PRIVILEGE token - it is baked into the CRX and GPO artifacts.
# Generate with: openssl rand -hex 24
EXT_SHARED_TOKEN=generate-a-long-random-value-here

# Admin token: unlocks ALL management APIs (/api/*, header X-Admin-Token).
# REQUIRED in production (the server refuses to start without it). Must be
# distinct from EXT_SHARED_TOKEN and must never be placed in artifacts.
# Generate with: openssl rand -hex 24
ADMIN_TOKEN=generate-a-different-long-random-value

# Public base URL of this server (scheme + host [+ port]). Used verbatim in
# generated artifacts (updates.xml codebase, GPO reg config) so Host-header
# poisoning cannot rewrite them. REQUIRED in production (docker-compose.prod
# enforces it); must be a bare origin: https://pec.example.corp (no path,
# no trailing slash). Leave empty for local dev (Host header is used then).
PUBLIC_BASE_URL=

# Client IP resolution for rate limiting and audit logs.
# false (default) - direct exposure; X-Forwarded-For is ignored (spoof-proof)
# 1               - exactly one reverse-proxy hop in front (nginx, LB)
# true            - trust every hop (use only inside trusted networks)
TRUST_PROXY=false

# --- Persistent state paths (point them at a backed-up location in prod) ---
CREDS_STORE=./current_creds.json
PROXY_CONFIG_PATH=./proxy_config.json
ROUTING_PROFILES_PATH=./routing_profiles.json
INSTANCES_META_PATH=./instances_meta.json
ROTATION_CONFIG_PATH=./rotation_config.json
ROTATION_HISTORY_PATH=./rotation_history.json
BUILDER_CONFIG=./extension_build_config.json

# --- Default proxy fleet configuration ---
PROXY_HOST=10.0.0.1
PROXY_PORT=10809

# --- 3x-ui panel integration (credential rotation) ---
XUI_PANEL_URL=https://3xui-host:2053/basepath
XUI_ADMIN_USER=admin
XUI_ADMIN_PASS=change-me
XUI_INBOUND_REMARK=squid-in
ROTATION_INTERVAL_MIN=1440
