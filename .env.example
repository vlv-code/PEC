# Server Network Configuration
PORT=3000
HOST=0.0.0.0

# Authentication & Extension Security (Change in Production!)
EXT_SHARED_TOKEN=corp-proxy-secret-token-change-me

# Storage Paths
CREDS_STORE=./current_creds.json
PROXY_CONFIG_PATH=./proxy_config.json

# Default Proxy Gateway Settings
PROXY_HOST=10.0.0.1
PROXY_PORT=10809

# 3x-ui / Xray Management Panel (for automated credential rotation)
XUI_PANEL_URL=https://3xui-host:2053/basepath
XUI_ADMIN_USER=admin
XUI_ADMIN_PASS=change-me
XUI_INBOUND_REMARK=squid-in
XUI_TIMEOUT=10
XUI_INSECURE_SKIP_VERIFY=false
