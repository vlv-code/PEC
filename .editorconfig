# EditorConfig helps developers define and maintain consistent coding styles
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{js,mjs,cjs,json,yaml,yml,md,xml,html}]
indent_size = 2

[*.{service,timer}]
indent_size = 4
