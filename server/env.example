# Копировать в /opt/mini-server/env, заполнить реальными значениями, chmod 600.

# Токен, который извлекает расширение из chrome.storage.managed (раздаётся через GPO ExtensionSettings)
EXT_SHARED_TOKEN=generate-a-long-random-value-here

# Куда app.py и rotate.py пишут/читают текущие credentials
CREDS_STORE=/opt/mini-server/current_creds.json

# 3x-ui API
XUI_PANEL_URL=https://3xui-host:2053/basepath
XUI_ADMIN_USER=admin
XUI_ADMIN_PASS=change-me
XUI_INBOUND_REMARK=squid-in

# Таймаут запросов к 3x-ui API (в секундах)
XUI_TIMEOUT=10

# Пропуск проверки TLS-сертификата панели 3x-ui (true, если используется самоподписанный сертификат без корневого в системе)
XUI_INSECURE_SKIP_VERIFY=false
