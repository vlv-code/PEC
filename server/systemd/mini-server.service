[Unit]
Description=Mini-server: proxy creds distribution
After=network.target

[Service]
EnvironmentFile=/opt/mini-server/env
ExecStart=/opt/mini-server/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8443
WorkingDirectory=/opt/mini-server
Restart=on-failure
RestartSec=5s
User=mini-server
Group=mini-server

[Install]
WantedBy=multi-user.target
