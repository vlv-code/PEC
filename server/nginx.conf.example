# TLS-терминация + сетевой allow/deny перед мини-сервером (uvicorn на 127.0.0.1:8443).
# Сертификат — внутренний CA (если есть для других внутренних сервисов) или
# самоподписанный + раздача root-сертификата на клиенты через GPO Certificate Policy.
# Без валидного для клиента сертификата расширение получит fetch-ошибку в /creds.

server {
    listen 443 ssl;
    server_name mini-server.ic.local;

    ssl_certificate     /etc/ssl/internal/mini-server.crt;
    ssl_certificate_key /etc/ssl/internal/mini-server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # грубый сетевой фильтр — актуальные корпоративные подсети
    allow 10.20.0.0/16;
    deny all;

    # Опционально: хостинг пакетов расширения (.crx) и update-манифеста (updates.xml) для GPO.
    # Файлы генерируются утилитой extension/scripts/pack.py и копируются в /opt/mini-server/updates/.
    location /updates/ {
        alias /opt/mini-server/updates/;
        autoindex off;
        default_type application/octet-stream;
        types {
            application/x-chrome-extension crx;
            text/xml xml;
        }
    }

    location / {
        proxy_pass http://127.0.0.1:8443;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;

        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }
}
